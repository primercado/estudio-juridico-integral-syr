// Publicación del sitio en Cloudflare Workers.
// - Solo se publica la carpeta public/ (index.html, css, js, assets). Nada de la
//   raíz del repositorio (expedientes, biblioteca, etc.) puede quedar en internet.
// - worker/index.js atiende /api/ulpiano, el asistente virtual con IA.
{
  "name": "estudio-juridico-integral-syr",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-22",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "ai": {
    "binding": "AI",
    "remote": true
  },
  // máximo de mensajes a Ulpiano por persona (IP) por minuto
  "ratelimits": [
    {
      "name": "LIMITE_ULPIANO",
      "namespace_id": "1001",
      "simple": { "limit": 8, "period": 60 }
    }
  ],
  "vars": {
    // modelo de Workers AI que usa Ulpiano (se cambia acá, en una línea)
    "ULPIANO_MODELO": "@cf/google/gemma-4-26b-a4b-it"
  }
}
